@model ImportOrderIndexViewModel
@{
    ViewData["Title"] = "Eliminar Orden";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4 text-center">
                    <div class="text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">¿Eliminar esta orden?</h4>
                    <p class="text-muted mb-4">Esta acción cancelará la orden de importación <strong>@Model.OrderNumber</strong>.</p>

                    <div class="text-start bg-light rounded p-3 mb-4">
                        <div class="row g-2">
                            <div class="col-6">
                                <span class="text-muted small">Fecha:</span>
                                <span class="d-block">@Model.OrderDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Estado:</span>
                                <span class="d-block">
                                    @switch (Model.Status)
                                    {
                                        case ImportOrderStatus.Open: <span class="badge bg-primary">Abierta</span> break;
                                        case ImportOrderStatus.Cancelled: <span class="badge bg-danger">Cancelada</span> break;
                                        default: <span>@Model.Status</span> break;
                                    }
                                </span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Importador:</span>
                                <span class="d-block">@Model.ImporterName</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Proveedor:</span>
                                <span class="d-block">@Model.SupplierName</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">País:</span>
                                <span class="d-block">@Model.CountryName</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Productos:</span>
                                <span class="d-block">@Model.DetailCount</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>Eliminar Orden
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
