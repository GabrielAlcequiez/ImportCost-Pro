@model LandedCostCalculationIndexViewModel
@{
    ViewData["Title"] = "Cálculo de Costo Terrestre";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary fw-bold">Cálculo de Costo Terrestre (Landed Cost)</h2>
    </div>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@successMsg</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@errorMsg</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        @* Formulario de Cálculo *@
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                            <i class="bi bi-calculator fs-3"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Calcular Orden</h5>
                            <small class="text-muted">Procesa y genera el cálculo oficial</small>
                        </div>
                    </div>
                    
                    <hr class="text-muted mb-4" />

                    @if (!Model.OpenOrders.Any())
                    {
                        <div class="text-center py-4 my-auto text-muted">
                            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                            <p class="small mb-0">No hay órdenes de importación abiertas en el sistema que requieran cálculo.</p>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Calculate" method="post" class="mt-2 flex-grow-1 d-flex flex-column justify-content-between">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label for="importOrderId" class="form-label fw-semibold text-secondary">Seleccione la Orden Abierta</label>
                                <select id="importOrderId" name="importOrderId" asp-for="SelectedImportOrderId" asp-items="Model.OpenOrders" class="form-select">
                                </select>
                                <div class="form-text small text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Para poder calcular, la orden debe tener productos agregados y los gastos de flete y seguro internacional registrados.
                                </div>
                            </div>
                            <div class="d-grid mt-auto">
                                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                    <i class="bi bi-play-circle-fill me-2"></i>Calcular Landed Cost
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

        @* Listado Histórico *@
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Historial de Cálculos Oficiales</h5>
                    <hr class="text-muted mb-4" />

                    @if (!Model.HistoryItems.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-receipt-cutoff display-4 d-block mb-3"></i>
                            <p>No se han registrado cálculos oficiales todavía.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha Cálculo</th>
                                        <th>Nº Orden</th>
                                        <th>Importador / Proveedor</th>
                                        <th class="text-end">Costo Total</th>
                                        <th class="text-center">Estado Orden</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.HistoryItems)
                                    {
                                        <tr>
                                            <td>
                                                <small class="fw-semibold">@item.CalculationDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary">@item.OrderNumber</span>
                                            </td>
                                            <td>
                                                <div class="small fw-bold text-dark text-truncate" style="max-width: 200px;" title="@item.ImporterName">
                                                    @item.ImporterName
                                                </div>
                                                <div class="text-muted small text-truncate" style="max-width: 200px;" title="Proveedor: @item.SupplierName">
                                                    Prov: @item.SupplierName
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @item.LocalCurrencyCode @item.ImportTotalCost.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                @if (item.OrderStatus == ImportOrderStatus.Calculated)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">Calculada</span>
                                                }
                                                else if (item.OrderStatus == ImportOrderStatus.Closed)
                                                {
                                                    <span class="badge bg-dark-subtle text-dark border border-dark">Cerrada</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="Details" asp-route-id="@item.CalculationId" class="btn btn-sm btn-outline-primary" title="Ver Detalles del Cálculo">
                                                    <i class="bi bi-eye-fill me-1"></i>Ver Resultados
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
