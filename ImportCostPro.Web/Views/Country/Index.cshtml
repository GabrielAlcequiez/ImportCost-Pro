@model IEnumerable<CountryViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Paises";
}

<div class="row">
    <div>
        <h1 class="display-4 text-center">Listado de Paises</h1>
    </div>
</div>


<div class="container-fluid px-4">

    @if (TempData["DeleteMessage"] is string message)
    {
        var alertClass = TempData["DeleteType"]?.ToString() switch
        {
            "soft" => "warning",
            "hard" => "success",
            "error" => "danger",
            _ => "info"
        };
        var iconClass = alertClass switch
        {
            "warning" => "bi-exclamation-circle",
            "success" => "bi-check-circle",
            "danger" => "bi-x-circle",
            _ => "bi-info-circle"
        };
        <div class="alert alert-@alertClass alert-dismissible fade show mt-3 d-flex align-items-center" role="alert">
            <i class="bi @iconClass me-2"></i>
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Mantenimiento de Países</h2>
        <a asp-controller="Country" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar País
        </a>
    </div>

    <div class="row g-4 mt-2">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-globe2 display-1 d-block mb-3"></i>
                <p>No hay países registrados en el sistema actualmente.</p>
            </div>
        }
        else
        {
            @foreach (var country in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(country.IsActive ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                            @(country.IsActive ? "Activo" : "Inactivo")
                        </span>

                        <div class="card-body d-flex flex-column pt-4">
                            <span class="text-uppercase text-muted fw-bold small tracking-wider mb-1">
                                @country.ISOCode
                            </span>

                            <h4 class="card-title text-dark fw-semibold mb-4 text-truncate" title="@country.Name">
                                @country.Name
                            </h4>

                            <div class="mt-auto pt-2 border-top">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="Edit" asp-route-id="@country.Id" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-pencil-square me-2"></i> Editar
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-action="Delete" asp-route-id="@country.Id" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-trash3 me-2"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>