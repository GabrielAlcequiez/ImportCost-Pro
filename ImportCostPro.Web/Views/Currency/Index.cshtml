@model IEnumerable<CurrencyViewModel>
@{
    ViewData["Title"] = "Monedas";
}

<div class="container-fluid px-4">

    @if (TempData["DeleteMessage"] is string message)
    {
        var alertClass = TempData["DeleteType"]?.ToString() switch
        {
            "soft" => "warning",
            "hard" => "success",
            "error" => "danger",
            _ => "info"
        };
        var iconClass = alertClass switch
        {
            "warning" => "bi-exclamation-circle",
            "success" => "bi-check-circle",
            "danger" => "bi-x-circle",
            _ => "bi-info-circle"
        };
        <div class="alert alert-@alertClass alert-dismissible fade show mt-3 d-flex align-items-center" role="alert">
            <i class="bi @iconClass me-2"></i>
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Mantenimiento de Monedas</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Moneda
        </a>
    </div>

    <div class="row g-4 mt-2">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-currency-exchange display-1 d-block mb-3"></i>
                <p>No hay monedas registradas en el sistema actualmente.</p>
            </div>
        }
        else
        {
            @foreach (var currency in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(currency.IsActive ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                            @(currency.IsActive ? "Activa" : "Inactiva")
                        </span>

                        <div class="card-body d-flex flex-column pt-4">
                            <div class="d-flex align-items-center mb-2">
                                <span class="fs-2 fw-bold text-primary me-2">@currency.Symbol</span>
                                <span class="text-uppercase text-muted fw-bold small">@currency.ISOCode</span>
                            </div>

                            <h4 class="card-title text-dark fw-semibold mb-2 text-truncate" title="@currency.Name">
                                @currency.Name
                            </h4>

                            @if (currency.IsLocalCurrency)
                            {
                                <span class="badge bg-info-subtle text-info border border-info mb-3" style="width:fit-content">
                                    <i class="bi bi-house-fill me-1"></i>Moneda Local
                                </span>
                            }

                            <div class="mt-auto pt-2 border-top">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="Edit" asp-route-id="@currency.Id" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-pencil-square me-2"></i>Editar
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-action="Delete" asp-route-id="@currency.Id" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-trash3 me-2"></i>Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
