@model UpdateCurrencyViewModel
@{
    ViewData["Title"] = "Editar Moneda";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold mb-0 text-dark">Editar Moneda</h4>
                            <small class="text-muted">Modifica los datos de la moneda.</small>
                        </div>
                    </div>

                    <hr class="text-muted mb-4" />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="IsActive" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary">Nombre</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Dólar Estadounidense" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="ISOCode" class="form-label fw-semibold text-secondary">Código ISO</label>
                                <input asp-for="ISOCode" class="form-control text-uppercase" maxlength="3" autocomplete="off" />
                                <span asp-validation-for="ISOCode" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Symbol" class="form-label fw-semibold text-secondary">Símbolo</label>
                                <input asp-for="Symbol" class="form-control" maxlength="5" autocomplete="off" />
                                <span asp-validation-for="Symbol" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsLocalCurrency" class="form-check-input" type="checkbox" role="switch" id="isLocalSwitch" />
                                <label class="form-check-label fw-semibold text-secondary" for="isLocalSwitch">Moneda Local</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
