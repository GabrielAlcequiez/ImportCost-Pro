@model IEnumerable<TariffCategoryViewModel>
@{
    ViewData["Title"] = "Categorías Arancelarias";
}

<div class="container-fluid px-4">

    @if (TempData["DeleteMessage"] is string message)
    {
        var alertClass = TempData["DeleteType"]?.ToString() switch
        {
            "soft" => "warning",
            "hard" => "success",
            "error" => "danger",
            _ => "info"
        };
        var iconClass = alertClass switch
        {
            "warning" => "bi-exclamation-circle",
            "success" => "bi-check-circle",
            "danger" => "bi-x-circle",
            _ => "bi-info-circle"
        };
        <div class="alert alert-@alertClass alert-dismissible fade show mt-3 d-flex align-items-center" role="alert">
            <i class="bi @iconClass me-2"></i>
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Categorías Arancelarias</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Categoría
        </a>
    </div>

    <div class="row g-4 mt-2">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-tags-fill display-1 d-block mb-3"></i>
                <p>No hay categorías arancelarias registradas actualmente.</p>
            </div>
        }
        else
        {
            @foreach (var cat in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(cat.IsActive ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                            @(cat.IsActive ? "Activa" : "Inactiva")
                        </span>

                        <div class="card-body d-flex flex-column pt-4">
                            <span class="text-uppercase text-muted fw-bold small mb-1">@cat.TariffCode</span>
                            <h5 class="card-title text-dark fw-semibold mb-3 text-truncate" title="@cat.Name">@cat.Name</h5>

                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <span class="badge bg-primary-subtle text-primary border border-primary">
                                    Arancel: @cat.TariffPercentage%
                                </span>
                                @if (cat.ApplyITBIS)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">ITBIS</span>
                                }
                                @if (cat.ApplyExciseTax)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">
                                        Selectivo: @cat.ExciseTaxPercentage%
                                    </span>
                                }
                            </div>

                            <div class="mt-auto pt-2 border-top">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-pencil-square me-2"></i>Editar
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-trash3 me-2"></i>Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
