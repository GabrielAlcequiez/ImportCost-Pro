@model UpdateTariffCategoryViewModel
@{
    ViewData["Title"] = "Editar Categoría Arancelaria";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold mb-0 text-dark">Editar Categoría Arancelaria</h4>
                            <small class="text-muted">Modifica los datos de la categoría.</small>
                        </div>
                    </div>

                    <hr class="text-muted mb-4" />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="TariffCode" class="form-label fw-semibold text-secondary">Código Arancelario</label>
                                <input asp-for="TariffCode" class="form-control" autocomplete="off" />
                                <span asp-validation-for="TariffCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary">Nombre / Descripción</label>
                                <input asp-for="Name" class="form-control" autocomplete="off" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="TariffPercentage" class="form-label fw-semibold text-secondary">% Arancel</label>
                                <div class="input-group">
                                    <input asp-for="TariffPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="TariffPercentage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExciseTaxPercentage" class="form-label fw-semibold text-secondary">% Impuesto Selectivo</label>
                                <div class="input-group">
                                    <input asp-for="ExciseTaxPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="ExciseTaxPercentage" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-auto">
                                <div class="form-check form-switch">
                                    <input asp-for="ApplyITBIS" class="form-check-input" type="checkbox" role="switch" id="itbisSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary" for="itbisSwitch">Aplica ITBIS</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check form-switch">
                                    <input asp-for="ApplyExciseTax" class="form-check-input" type="checkbox" role="switch" id="exciseSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary" for="exciseSwitch">Aplica Impuesto Selectivo</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary" for="isActiveSwitch">Activa</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
