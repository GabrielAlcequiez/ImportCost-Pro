@model UpdateTaxConfigurationViewModel
@{
    ViewData["Title"] = "Editar Configuración de Impuestos";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver a la configuración
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold mb-0 text-dark">Editar Configuración de Impuestos</h4>
                            <small class="text-muted">Modifica los porcentajes de impuestos y tasas.</small>
                        </div>
                    </div>

                    <hr class="text-muted mb-4" />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="GeneralItbisPercentage" class="form-label fw-semibold text-secondary">ITBIS General (%)</label>
                            <input asp-for="GeneralItbisPercentage" class="form-control" type="number" step="0.01" lang="en" placeholder="Ej: 18.00" autocomplete="off" />
                            <span asp-validation-for="GeneralItbisPercentage" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomsServiceFeePercentage" class="form-label fw-semibold text-secondary">Honorarios de Aduana (%)</label>
                            <input asp-for="CustomsServiceFeePercentage" class="form-control" type="number" step="0.0001" lang="en" placeholder="Ej: 3.0000" autocomplete="off" />
                            <span asp-validation-for="CustomsServiceFeePercentage" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
