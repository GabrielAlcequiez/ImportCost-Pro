@model TaxConfigurationViewModel
@{
    ViewData["Title"] = "Configuración de Impuestos";
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Configuración de Impuestos</h2>
        <a asp-action="Edit" class="btn btn-warning shadow-sm">
            <i class="bi bi-pencil-square me-2"></i>Editar Configuración
        </a>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">

                <div class="card-body d-flex flex-column pt-4">

                    <h5 class="card-title text-dark fw-semibold mb-1">Impuestos y Tasas</h5>

                    <span class="text-muted small mb-1 mt-2">
                        <i class="bi bi-percent me-1"></i>ITBIS General:
                    </span>
                    <strong class="mb-2">@Model.GeneralItbisPercentage.ToString("N2")%</strong>

                    <span class="text-muted small mb-1">
                        <i class="bi bi-cash-stack me-1"></i>Honorarios de Aduana:
                    </span>
                    <strong class="mb-2">@Model.CustomsServiceFeePercentage.ToString("N4")%</strong>

                </div>
            </div>
        </div>
    </div>
</div>
