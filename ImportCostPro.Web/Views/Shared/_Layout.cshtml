<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImportCost Pro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ImportCostPro.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill me-2 text-primary"></i>ImportCost Pro
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @* Mantenimientos *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-gear-fill me-1"></i>Mantenimientos
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li>
                                    <a class="dropdown-item" asp-controller="Country" asp-action="Index">
                                        <i class="bi bi-globe2 me-2"></i>Países
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Currency" asp-action="Index">
                                        <i class="bi bi-currency-exchange me-2"></i>Monedas
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TariffCategory" asp-action="Index">
                                        <i class="bi bi-tags-fill me-2"></i>Categorías Arancelarias
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Importer" asp-action="Index">
                                        <i class="bi bi-person-badge-fill me-2"></i>Importadores
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Supplier" asp-action="Index">
                                        <i class="bi bi-truck me-2"></i>Proveedores
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-box-fill me-2"></i>Productos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="ExchangeRate" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-2"></i>Tasas de Cambio
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TaxConfiguration" asp-action="Index">
                                        <i class="bi bi-percent me-2"></i>Config. de Impuestos
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @* Importaciones *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-file-earmark-text-fill me-1"></i>Importaciones
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li>
                                    <a class="dropdown-item" asp-controller="ImportOrder" asp-action="Index">
                                        <i class="bi bi-clipboard2-data-fill me-2"></i>Órdenes de Importación
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @* Cálculos *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-calculator-fill me-1"></i>Cálculos
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li>
                                    <a class="dropdown-item" asp-controller="LandedCostCalculation" asp-action="Index">
                                        <i class="bi bi-cash-stack me-2"></i>Calculo de Landed Cost
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3 bg-light">
        <div class="container-fluid px-4">
            <small>&copy; 2026 - ImportCost Pro &mdash; Gabriel Alcequiez / Jose Rincon</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
