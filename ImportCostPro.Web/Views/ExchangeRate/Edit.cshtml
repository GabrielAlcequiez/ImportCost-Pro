@model UpdateExchangeRateViewModel
@{
    ViewData["Title"] = "Editar Tasa de Cambio";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold mb-0 text-dark">Editar Tasa de Cambio</h4>
                            <small class="text-muted">Modifica los datos de la tasa de cambio.</small>
                        </div>
                    </div>

                    <hr class="text-muted mb-4" />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        @if (!Model.IsActive)
                        {
                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary" for="isActiveSwitch">Activar</label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="IsActive" />
                        }
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="SourceCurrencyId" class="form-label fw-semibold text-secondary">Moneda Origen</label>
                                <select asp-for="SourceCurrencyId" asp-items="Model.Currencies" class="form-select">
                                    <option value="">-- Selecciona una moneda --</option>
                                </select>
                                <span asp-validation-for="SourceCurrencyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TargetCurrencyId" class="form-label fw-semibold text-secondary">Moneda Destino</label>
                                <select asp-for="TargetCurrencyId" asp-items="Model.Currencies" class="form-select">
                                    <option value="">-- Selecciona una moneda --</option>
                                </select>
                                <span asp-validation-for="TargetCurrencyId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="RateValue" class="form-label fw-semibold text-secondary">Tasa de Cambio</label>
                                <input asp-for="RateValue" class="form-control" type="number" step="0.0001" lang="en" autocomplete="off" />
                                <span asp-validation-for="RateValue" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EffectiveDate" class="form-label fw-semibold text-secondary">Fecha de Vigencia</label>
                                <input asp-for="EffectiveDate" class="form-control" type="date" />
                                <span asp-validation-for="EffectiveDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
