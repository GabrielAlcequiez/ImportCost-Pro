@model IEnumerable<ImporterViewModel>
@{
    ViewData["Title"] = "Importadores";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Mantenimiento de Importadores</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Importador
        </a>
    </div>

    <div class="row g-4 mt-2">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-person-badge-fill display-1 d-block mb-3"></i>
                <p>No hay importadores registrados en el sistema actualmente.</p>
            </div>
        }
        else
        {
            @foreach (var importer in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(importer.IsActive ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                            @(importer.IsActive ? "Activo" : "Inactivo")
                        </span>

                        <div class="card-body d-flex flex-column pt-4">
                            <h5 class="card-title text-dark fw-semibold mb-1 text-truncate" title="@importer.Name">@importer.Name</h5>

                            <span class="text-muted small mb-2">
                                <i class="bi bi-hash me-1"></i>@importer.TaxId
                            </span>

                            <span class="text-muted small mb-1">
                                <i class="bi bi-globe2 me-1"></i>@importer.CountryName
                            </span>

                            @if (!string.IsNullOrEmpty(importer.Email))
                            {
                                <span class="text-muted small text-truncate mb-1" title="@importer.Email">
                                    <i class="bi bi-envelope me-1"></i>@importer.Email
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(importer.Phone))
                            {
                                <span class="text-muted small mb-1">
                                    <i class="bi bi-telephone me-1"></i>@importer.Phone
                                </span>
                            }

                            <div class="mt-auto pt-2 border-top">
                                <a asp-action="Edit" asp-route-id="@importer.Id" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-pencil-square me-2"></i>Editar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
