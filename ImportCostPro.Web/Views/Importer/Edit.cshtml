@model UpdateImporterViewModel
@{
    ViewData["Title"] = "Editar Importador";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-3 text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>

            <div class="card shadow-sm border-0 mt-2">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold mb-0 text-dark">Editar Importador</h4>
                            <small class="text-muted">Modifica los datos del importador.</small>
                        </div>
                    </div>

                    <hr class="text-muted mb-4" />

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        @if (!Model.IsActive)
                        {
                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                    <label class="form-check-label fw-semibold text-secondary" for="isActiveSwitch">Activar</label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="IsActive" />
                        }
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary">Nombre / Razón Social</label>
                                <input asp-for="Name" class="form-control" autocomplete="off" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TaxId" class="form-label fw-semibold text-secondary">RNC / Cédula Fiscal</label>
                                <input asp-for="TaxId" class="form-control" autocomplete="off" />
                                <span asp-validation-for="TaxId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CountryId" class="form-label fw-semibold text-secondary">País</label>
                            <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
                                <option value="">-- Selecciona un país --</option>
                            </select>
                            <span asp-validation-for="CountryId" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold text-secondary">Teléfono <span class="text-muted small">(opcional)</span></label>
                                <input asp-for="Phone" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary">Correo <span class="text-muted small">(opcional)</span></label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="off" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary">Dirección <span class="text-muted small">(opcional)</span></label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
